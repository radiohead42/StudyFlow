<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
<TargetFramework>net10.0</TargetFramework>
<Nullable>enable</Nullable>
<ImplicitUsings>enable</ImplicitUsings>
<UserSecretsId>f02e7d13-8473-4684-a989-21132390cc6b</UserSecretsId>
</PropertyGroup>

<ItemGroup>
<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
<PrivateAssets>all</PrivateAssets>
</PackageReference>
<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
<PackageReference Include="Riok.Mapperly" Version="4.3.1" />
</ItemGroup>

<Target Name="PostPublishStep" AfterTargets="Publish">
<Message
Text="Publishing executable database migration bundle"
Importance="High" />

<Exec
Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot;" />

<Exec
Command="dotnet ef migrations bundle --project &quot;$(MSBuildProjectFullPath)&quot; --startup-project &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(PublishDir)efbundle&quot; --force" />
</Target>

</Project>
